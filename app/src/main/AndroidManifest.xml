<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- No internet access: messages never leave the device and nothing is fetched. Removed even
         if a library asks for it, so it can't come back unnoticed. (MMS needs none: the system's
         MMS service does the network part.) -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <!-- Call button in conversations and the "Call" swipe: calls directly once allowed, else opens the dialler. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Voice messages (MMS); asked for the first time the mic is tapped. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:name=".MessagesApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Messages">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_MESSAGING" />
            </intent-filter>
            <!-- Required for the default SMS app role: compose a message to sms:/mms: URIs. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </activity>
    </application>
</manifest>
